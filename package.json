    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdoc": "^4.0.2",
    "prettier": "^3.1.1",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  }
}
